# Web3Auth (MetaMask Embedded Wallets) — free client ID for social login.
# Get one at https://dashboard.web3auth.io (Sapphire Devnet, EVM).
# Public value, safe to expose. Leave empty to use AvaKit's bundled demo key
# (works on localhost only) — set your own before deploying to a real domain.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# --- x402 payment base (after scripts/deploy-x402.mjs) ---
# Settlement token (AgentToken, EIP-3009) + payment pool (AgentPayments).
X402_TOKEN=
X402_PAYTO=
X402_TOKEN_NAME=AgentToken
# Fixed price per agent task in atomic units (0.001 AGT at 18 decimals).
X402_AMOUNT=1000000000000000
# Demo mode serves the resource without a real on-chain tx (default true).
# Set X402_DEMO=false to require on-chain settlement via /api/x402/settle.
X402_DEMO=true
# Facilitator wallet that pays gas to broadcast the agent's EIP-3009 transfer.
# NEVER commit a real key here — set it in your local shell only.
X402_DEPLOYER_PRIVATE_KEY=

# --- Optional integrations ---
# Envio HyperRPC (Monad Testnet) — the on-chain read layer for /api/ledger.
# Get a free API token at https://app.envio.dev/api. When set, the ledger reads
# the full PaymentRecorded history in a single HyperRPC call; without it the
# ledger falls back to a paced public-RPC scan of a recent block window.
ENVIO_API_TOKEN=

# Dynamic embedded (WaaS) wallets — adds an embedded-wallet signer to the demo.
# Get an environment ID at https://console.dynamic.xyz. When empty, the Dynamic
# card is not rendered and the demo keeps its burner / injected / Web3Auth path.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Public URL this deployment is served from — shown in the MCP/curl copy-paste
# snippets. Only needed if the live UI cannot read window.location.origin.
NEXT_PUBLIC_APP_URL=

# --- A2A task store (durability) ---
# Upstash Redis REST — with these two values the A2A task store survives a cold
# start / a second instance. Server-only, never exposed to the browser. Leave
# empty to fall back to an in-process map (single-instance demo only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vendor-billed resources (proves the meter against a paid API) ---
# Alibaba Cloud Model Studio (DashScope) key — enables the `inference:tiny`
# metered task, served by qwen3.8-max over the OpenAI-compatible endpoint.
# Leave empty and the endpoint honestly reports outputMode "unconfigured"
# instead of faking a response.
DASHSCOPE_API_KEY=
# Optional overrides:
#   DASHSCOPE_MODEL   — default qwen3.8-max
#   DASHSCOPE_BASE_URL — default https://dashscope.aliyuncs.com/compatible-mode/v1
#                        (use the international host or a workspace-scoped URL if needed)
DASHSCOPE_MODEL=
DASHSCOPE_BASE_URL=

# Moonshot AI (Kimi) key — enables the `inference:kimi` metered task, served over
# the OpenAI-compatible endpoint. Same story: no key → honest "unconfigured".
MOONSHOT_API_KEY=
# Optional overrides:
#   MOONSHOT_MODEL    — default kimi-k3
#   MOONSHOT_BASE_URL — default https://api.moonshot.cn/v1
#                        (use https://api.moonshot.ai/v1 for the international host)
MOONSHOT_MODEL=
MOONSHOT_BASE_URL=

# --- Identity attestation (optional) ---
# Comma-separated allowlist of attester addresses. When set, an identity
# attestation is only trusted if signed by one of them; otherwise a valid
# self-signed attestation is still reported, but as trust "self-attested".
IDENTITY_ATTESTER=
